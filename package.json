{
  "name": "@bloxwap/hyperliquid-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:format && bun run check:lint && bun run check:docs && bun run check:sdk",
    "check:format": "biome format .",
    "check:lint": "biome lint .",
    "check:docs": "cd apps/docs && bun run check:content",
    "check:sdk": "cd packages/hyperliquid && bun run check",
    "check:types": "cd packages/hyperliquid && bun run check:types",
    "check:ts7": "cd packages/hyperliquid && bun run check:ts7",
    "check:jsdoc": "cd packages/hyperliquid && bun run check:jsdoc",
    "check:export": "cd packages/hyperliquid && bun run check:export",
    "check:imports": "cd packages/hyperliquid && bun run check:imports",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "test": "cd packages/hyperliquid && bun run test",
    "test:offline": "cd packages/hyperliquid && bun run test:offline",
    "perf": "cd packages/hyperliquid && bun run perf",
    "perf:gate": "cd packages/hyperliquid && bun run perf:gate",
    "build": "cd packages/hyperliquid && bun run build",
    "docs:dev": "cd apps/docs && bun run dev",
    "docs:build": "cd apps/docs && bun run build",
    "docs:preview": "cd apps/docs && bun run preview",
    "docs:check": "cd apps/docs && bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5"
  },
  "overrides": {
    "katex": "0.18.11",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
