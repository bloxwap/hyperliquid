# Dependencies (root install, plus the pinned TypeScript 7 gate under .dev/ts7).
node_modules/

# Output of `bun run build`.
dist/

# Output of `bun test --coverage`.
coverage/

# Agent worktrees and local session state.
.claude/
.dev/worktrees/

# Local agent prompts under .dev/ can reference private repos; keep them out of this public one.
.dev/*.md

# macOS Finder metadata.
.DS_Store

# Generated documentation website files.
website/.next/
website/.source/
website/out/
website/tsconfig.tsbuildinfo

# Local secrets. Tests load `PRIVATE_KEY` from the environment, and Bun auto-loads `.env` —
# a funded key must never be committable.
.env
.env.*
