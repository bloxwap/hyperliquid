{
  "name": "@bloxwap/hyperliquid-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fumadocs-mdx && next dev --port 3901",
    "preview": "bun run scripts/preview.ts",
    "build": "fumadocs-mdx && next build && bun run scripts/export-markdown.ts && bun run scripts/verify-export.ts",
    "check": "bun run check:content && fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "bun test lib/",
    "check:content": "bun run scripts/check-content.ts && markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc ../../README.md ../../packages/hyperliquid/README.md README.md \"content/**/*.md\""
  },
  "dependencies": {
    "@bloxwap/font": "0.1.1",
    "@bloxwap/hyperliquid": "workspace:*",
    "animejs": "4.4.0",
    "fumadocs-core": "16.15.14",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.14",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "markdownlint-cli2": "0.23.3"
  }
}
